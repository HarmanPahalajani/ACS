# Awasthi Consultancy Services (ACS) - Local Environment Variables
# Used by local server runtime and Cloudflare Pages Functions
# DO NOT COMMIT SECRETS TO GIT

# Recipient Email for Lead Notifications (Leave unconfigured by default)
INQUIRY_RECIPIENT_EMAIL=""

# Optional Resend API Key for live email dispatch (e.g. re_xxxx)
# RESEND_API_KEY=""

# Verified Sending Email in Resend (default testing address or verified custom domain)
RESEND_SENDER_EMAIL="ACS Web Desk <onboarding@resend.dev>"

# Set to true to test email logging to console without an external API key
ALLOW_LOCAL_SIMULATION=false

# Web3Forms Access Key for direct client inquiry dispatch
VITE_WEB3FORMS_ACCESS_KEY="your-web3forms-access-key-here"
